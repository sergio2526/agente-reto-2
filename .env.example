# Clave del proveedor LLM (solo backend; nunca en el front ni en el repo)
ANTHROPIC_API_KEY=

# Proveedor: auto (Anthropic si hay clave; si no, simulado) | anthropic | simulado
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_TIMEOUT_MS=120000
LLM_MAX_OUTPUT_TOKENS=16000

# Topes de costo
MAX_ITERATIONS=25
MAX_SESSION_TOKENS=1500000
MAX_GLOBAL_TOKENS=20000000

# Si se define, el front y la API exigen esta clave (cabecera x-access-key)
ACCESS_KEY=

PORT=3004
